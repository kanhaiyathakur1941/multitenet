#!/usr/bin/env bash
set -euo pipefail

PHP_BIN="php"

for version in 8.4 8.3 8.2; do
    if [ -x "/opt/homebrew/opt/php@${version}/bin/php" ]; then
        PHP_BIN="/opt/homebrew/opt/php@${version}/bin/php"
        break
    fi

    if [ -x "/usr/local/opt/php@${version}/bin/php" ]; then
        PHP_BIN="/usr/local/opt/php@${version}/bin/php"
        break
    fi
done

modules=$("$PHP_BIN" -m 2>/dev/null)

if ! grep -qFx intl <<< "$modules"; then
    echo "The PHP intl extension is required for Filament."
    echo "Install Homebrew PHP: brew install php@8.2"
    echo "Then run: export PATH=\"/opt/homebrew/opt/php@8.2/bin:\$PATH\""
    exit 1
fi

exec "$PHP_BIN" artisan serve "$@"
