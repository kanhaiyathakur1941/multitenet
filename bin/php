#!/usr/bin/env bash
set -euo pipefail

for version in 8.4 8.3 8.2; do
    if [ -x "/opt/homebrew/opt/php@${version}/bin/php" ]; then
        exec "/opt/homebrew/opt/php@${version}/bin/php" "$@"
    fi

    if [ -x "/usr/local/opt/php@${version}/bin/php" ]; then
        exec "/usr/local/opt/php@${version}/bin/php" "$@"
    fi
done

exec php "$@"
